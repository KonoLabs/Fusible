{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fusible Studio",
  "version": "0.14.3",
  "identifier": "dev.kono.fusible-studio",
  "build": {
    "beforeBuildCommand": "cd ../ui && bun install --frozen-lockfile && bun run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Fusible Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "category": "DeveloperTool",
    "shortDescription": "The fuse for your hardware",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/fusible", "binaries/bun"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
